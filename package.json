{
  "name": "dsh-eye-care-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Eye-care (warm paper) theme for DeepSeek Harness: a third palette beside light/dark, a Settings switch, and a one-click sidebar toggle.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "eye-care",
    "eye-comfort",
    "ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "houguofei",
  "homepage": "https://github.com/houguofei/dsh-eye-care-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houguofei/dsh-eye-care-theme.git"
  },
  "bugs": {
    "url": "https://github.com/houguofei/dsh-eye-care-theme/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
